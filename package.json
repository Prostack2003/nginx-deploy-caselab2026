{
    "name": "express-restapi-webcaselab2026",
    "version": "1.0.0",
    "description": "",
    "license": "ISC",
    "author": "Prostack2003",
    "type": "module",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
        "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/tests/unit --runInBand",
        "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/tests/integration --runInBand",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
        "db:test:migrate": "NODE_ENV=test sequelize-cli --options-path sequelize-paths.cjs --env test db:migrate",
        "db:test:migrate:undo": "NODE_ENV=test sequelize-cli --options-path sequelize-paths.cjs --env test db:migrate:undo:all",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": ">= 20.0.0"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "pg": "^8.23.0",
        "pg-hstore": "^2.3.4",
        "pino": "^10.3.1",
        "sequelize": "^6.37.8",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "prettier": "3.9.6",
        "sequelize-cli": "^6.6.5",
        "supertest": "^7.3.0"
    }
}
